# BridgeEd API — copy to `.env` and fill in. Every value below is a placeholder;
# `.env` itself is git-ignored and must never be committed.

# PostgreSQL connection string used by Prisma (the local Prisma Postgres dev
# server works here too).
DATABASE_URL="postgresql://user:password@localhost:5432/bridgeed"

# Port the Express server listens on. Defaults to 4000.
PORT=4000

# --- Authentication ---------------------------------------------------------

# HS256 signing key for access tokens. Required in production, minimum 32
# characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-with-at-least-32-random-characters"

# Issuer and audience written into, and required from, every access token.
AUTH_JWT_ISSUER="bridgeed-api"
AUTH_JWT_AUDIENCE="bridgeed-app"

# Access token lifetime in seconds. Defaults to 900 (15 minutes).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds. Defaults to 2592000 (30 days).
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Entropy, in bytes, of an opaque refresh token. Defaults to 32 (256 bits).
AUTH_REFRESH_TOKEN_BYTES=32

# scrypt parameters, stored inside every digest so they can be changed later.
# The cost exponent is N = 2^exponent; 15 is the default and the sane floor is
# 10 (e.g. for tests).
AUTH_SCRYPT_COST_EXPONENT=15
AUTH_SCRYPT_BLOCK_SIZE=8
AUTH_SCRYPT_PARALLELIZATION=1
AUTH_SCRYPT_KEY_LENGTH=64
AUTH_SCRYPT_SALT_BYTES=16
