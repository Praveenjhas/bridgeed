generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  role           UserRole
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
}

model StudentProfile {
  userId          String            @id
  name            String
  username        String            @unique
  bio             String?
  universityId    String?
  degree          String?
  branch          String?
  graduationYear  Int?
  profileImageUrl String?
  location        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interests       StudentInterest[]
  university      University?       @relation(fields: [universityId], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          StudentSkill[]

  connectionsBlockedBy Connection[]          @relation("ConnectionBlocker")
  connectionsReceived  Connection[]          @relation("ConnectionReceiver")
  connectionsRequested Connection[]          @relation("ConnectionRequester")
  communitiesCreated   Community[]           @relation("CommunityCreator")
  communityMemberships CommunityMembership[] @relation("CommunityMembershipUser")
  comments             Comment[]             @relation("CommentAuthor")
  commentReactions     CommentReaction[]     @relation("CommentReactionUser")
  postReactions        PostReaction[]        @relation("PostReactionUser")
  posts                Post[]                @relation("PostAuthor")
}

model University {
  id         String           @id @default(uuid())
  name       String
  country    String
  state      String?
  city       String?
  websiteUrl String?
  verified   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  students   StudentProfile[]
}

model Skill {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  students  StudentSkill[]
}

model Interest {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  students  StudentInterest[]
}

model StudentSkill {
  studentId String
  skillId   String
  createdAt DateTime       @default(now())
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, skillId])
}

model StudentInterest {
  studentId  String
  interestId String
  createdAt  DateTime       @default(now())
  interest   Interest       @relation(fields: [interestId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, interestId])
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  blockedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  blockedBy StudentProfile? @relation("ConnectionBlocker", fields: [blockedById], references: [userId], onDelete: SetNull)
  receiver  StudentProfile  @relation("ConnectionReceiver", fields: [receiverId], references: [userId], onDelete: Cascade)
  requester StudentProfile  @relation("ConnectionRequester", fields: [requesterId], references: [userId], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

model Community {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  type          CommunityType @default(PUBLIC)
  createdById   String
  coverImageUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy   StudentProfile        @relation("CommunityCreator", fields: [createdById], references: [userId], onDelete: Cascade)
  memberships CommunityMembership[]
  posts       Post[]

  @@index([createdById])
  @@index([createdAt])
  @@index([type])
}

model CommunityMembership {
  id          String                    @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole       @default(MEMBER)
  status      CommunityMembershipStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      StudentProfile @relation("CommunityMembershipUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId, status])
}

model Post {
  id          String    @id @default(uuid())
  authorId    String
  communityId String
  content     String
  type        PostType  @default(TEXT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  author    StudentProfile @relation("PostAuthor", fields: [authorId], references: [userId], onDelete: Cascade)
  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([communityId, createdAt])
  @@index([communityId, deletedAt])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author    StudentProfile   @relation("CommentAuthor", fields: [authorId], references: [userId], onDelete: Cascade)
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([authorId])
  @@index([postId, createdAt])
  @@index([postId, deletedAt])
}

/// Reactions are modelled per target so PostgreSQL can enforce real foreign
/// keys and uniqueness instead of relying on a polymorphic target column.
/// The unique index already covers lookups by postId, so no extra index is
/// needed for it.
model PostReaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  post Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user StudentProfile @relation("PostReactionUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([userId])
}

/// See PostReaction: the unique index already covers lookups by commentId.
model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  comment Comment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    StudentProfile @relation("CommentReactionUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([commentId, userId, type])
  @@index([userId])
}

enum UserRole {
  STUDENT
  MENTOR
  EDUCATOR
  ADMIN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum CommunityType {
  PUBLIC
  PRIVATE
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum PostType {
  TEXT
}

enum ReactionType {
  LIKE
}
