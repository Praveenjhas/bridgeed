generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  role           UserRole
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
}

model StudentProfile {
  userId          String            @id
  name            String
  username        String            @unique
  bio             String?
  universityId    String?
  degree          String?
  branch          String?
  graduationYear  Int?
  profileImageUrl String?
  location        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interests       StudentInterest[]
  university      University?       @relation(fields: [universityId], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          StudentSkill[]

  connectionsBlockedBy Connection[]           @relation("ConnectionBlocker")
  connectionsReceived  Connection[]           @relation("ConnectionReceiver")
  connectionsRequested Connection[]           @relation("ConnectionRequester")
  communitiesCreated   Community[]            @relation("CommunityCreator")
  communityMemberships CommunityMembership[]  @relation("CommunityMembershipUser")
}

model University {
  id         String           @id @default(uuid())
  name       String
  country    String
  state      String?
  city       String?
  websiteUrl String?
  verified   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  students   StudentProfile[]
}

model Skill {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  students  StudentSkill[]
}

model Interest {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  students  StudentInterest[]
}

model StudentSkill {
  studentId String
  skillId   String
  createdAt DateTime       @default(now())
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, skillId])
}

model StudentInterest {
  studentId  String
  interestId String
  createdAt  DateTime       @default(now())
  interest   Interest       @relation(fields: [interestId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, interestId])
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  blockedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  blockedBy StudentProfile? @relation("ConnectionBlocker", fields: [blockedById], references: [userId], onDelete: SetNull)
  receiver  StudentProfile  @relation("ConnectionReceiver", fields: [receiverId], references: [userId], onDelete: Cascade)
  requester StudentProfile  @relation("ConnectionRequester", fields: [requesterId], references: [userId], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

model Community {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  type          CommunityType @default(PUBLIC)
  createdById   String
  coverImageUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy   StudentProfile        @relation("CommunityCreator", fields: [createdById], references: [userId], onDelete: Cascade)
  memberships CommunityMembership[]

  @@index([createdById])
  @@index([createdAt])
  @@index([type])
}

model CommunityMembership {
  id          String                    @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole       @default(MEMBER)
  status      CommunityMembershipStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      StudentProfile @relation("CommunityMembershipUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId, status])
}

enum UserRole {
  STUDENT
  MENTOR
  EDUCATOR
  ADMIN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum CommunityType {
  PUBLIC
  PRIVATE
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}
