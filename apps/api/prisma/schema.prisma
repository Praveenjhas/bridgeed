generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An account owns the credentials and the authorisation role; what a student
/// studies lives on StudentProfile. `role` only decides whether an account may
/// administer the platform, so it stays deliberately coarse.
model User {
  id                String          @id @default(uuid())
  email             String          @unique
  role              UserRole        @default(USER)
  status            UserStatus      @default(ACTIVE)
  /// scrypt digest of the password. Null while an account exists without a
  /// usable password, which is the case for every row created before sign-up.
  passwordHash      String?
  /// When the password last changed, so sessions issued before that moment can
  /// be treated as stale.
  passwordUpdatedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  studentProfile    StudentProfile?
}

/// Refresh-token sessions. Access tokens are stateless and short lived, so they
/// are never stored; a refresh token is an opaque secret and only its SHA-256
/// digest is persisted. Rotating a refresh token revokes the session it
/// belonged to and issues a successor that keeps the same `familyId`, which is
/// what makes reuse detectable: a token whose session is already revoked can
/// only have been paired with a token that leaked, so the whole family is
/// revoked.
model Session {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Last time this session minted an access token, used for idle timeouts and
  /// for showing the user where they are signed in.
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sessions are read per user (everything a sign-out-all has to revoke) and
  /// per family (one rotation chain), always filtering on `revokedAt IS NULL`,
  /// so the user index carries that column. A family chain is only a handful of
  /// rows, so its index stays single-column. `expiresAt` is read from the row
  /// already located by `refreshTokenHash`, so it needs no index of its own.
  @@index([userId, revokedAt])
  @@index([familyId])
}

model StudentProfile {
  userId          String            @id
  name            String
  username        String            @unique
  bio             String?
  universityId    String?
  /// The programme the student is enrolled in. Optional: every profile that
  /// existed before the academic graph is still valid, and a student who has not
  /// picked one keeps working exactly as before.
  programId       String?
  degree          String?
  branch          String?
  graduationYear  Int?
  profileImageUrl String?
  location        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interests       StudentInterest[]
  program         Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  university      University?       @relation(fields: [universityId], references: [id])
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          StudentSkill[]

  connectionsBlockedBy Connection[]          @relation("ConnectionBlocker")
  connectionsReceived  Connection[]          @relation("ConnectionReceiver")
  connectionsRequested Connection[]          @relation("ConnectionRequester")
  communitiesCreated   Community[]           @relation("CommunityCreator")
  communityMemberships CommunityMembership[] @relation("CommunityMembershipUser")
  comments             Comment[]             @relation("CommentAuthor")
  commentReactions     CommentReaction[]     @relation("CommentReactionUser")
  postReactions        PostReaction[]        @relation("PostReactionUser")
  posts                Post[]                @relation("PostAuthor")

  @@index([universityId])
  @@index([programId])
}

model University {
  id          String           @id @default(uuid())
  name        String
  /// Stable URL-safe identifier derived from `name` when the row is created.
  slug        String           @unique
  country     String
  state       String?
  city        String?
  websiteUrl  String?
  /// A short editorial summary shown on the directory and profile screens.
  description String?
  /// Optional logo or profile image, stored the same way a profile picture is:
  /// as a URL, so the app can render it without an upload pipeline of its own.
  logoUrl     String?
  verified    Boolean          @default(false)
  /// Timestamp of the moment `verified` became true, so a future review trail
  /// does not have to guess from `updatedAt`. Null while unverified.
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  students    StudentProfile[]
  programs    Program[]
  communities Community[]
}

/// A degree programme offered by a university, for example "B.Tech Mechanical
/// Engineering". It is the middle of the academic graph — a university has many
/// programmes, a programme maps to subjects, and a student or community can
/// optionally point at one.
model Program {
  id           String   @id @default(uuid())
  universityId String
  name         String
  /// The qualification, for example "B.Tech". Null when the programme is not
  /// described by a single degree.
  degree       String?
  /// The broad field, for example "Engineering". Null when it is unknown.
  field        String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  subjects    ProgramSubject[]
  students    StudentProfile[]
  communities Community[]

  /// A university does not offer the same programme name twice.
  @@unique([universityId, name])
  @@index([universityId])
  @@index([name])
}

/// A subject taught inside one or more programmes, for example "Thermodynamics".
/// Subjects are shared across programmes, so the link between the two is a
/// many-to-many join table rather than a column on either side.
model Subject {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs    ProgramSubject[]
  communities Community[]

  @@index([name])
}

/// The many-to-many link between a programme and the subjects it teaches. An
/// explicit join model (rather than an implicit relation) follows the same shape
/// as `StudentSkill` and `StudentInterest`, so every join in the schema looks
/// alike.
model ProgramSubject {
  programId String
  subjectId String
  createdAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([programId, subjectId])
  @@index([subjectId])
}

model Skill {
  id        String         @id @default(uuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  students  StudentSkill[]
}

model Interest {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt DateTime          @default(now())
  students  StudentInterest[]
}

model StudentSkill {
  studentId String
  skillId   String
  createdAt DateTime       @default(now())
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, skillId])
}

model StudentInterest {
  studentId  String
  interestId String
  createdAt  DateTime       @default(now())
  interest   Interest       @relation(fields: [interestId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, interestId])
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  blockedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  blockedBy StudentProfile? @relation("ConnectionBlocker", fields: [blockedById], references: [userId], onDelete: SetNull)
  receiver  StudentProfile  @relation("ConnectionReceiver", fields: [receiverId], references: [userId], onDelete: Cascade)
  requester StudentProfile  @relation("ConnectionRequester", fields: [requesterId], references: [userId], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId, status])
  @@index([receiverId, status])
}

model Community {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  type          CommunityType @default(PUBLIC)
  createdById   String
  coverImageUrl String?
  /// Optional academic context. Every community that existed before the academic
  /// graph leaves all three null and keeps working exactly as it did; a new one
  /// may anchor itself to a university, a programme and/or a subject. The
  /// `SetNull` behaviour means deleting academic data never deletes a community.
  universityId  String?
  programId     String?
  subjectId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy   StudentProfile        @relation("CommunityCreator", fields: [createdById], references: [userId], onDelete: Cascade)
  university  University?           @relation(fields: [universityId], references: [id], onDelete: SetNull)
  program     Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  subject     Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  memberships CommunityMembership[]
  posts       Post[]

  @@index([createdById])
  @@index([createdAt])
  @@index([type])
  @@index([universityId])
  @@index([programId])
  @@index([subjectId])
}

model CommunityMembership {
  id          String                    @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole       @default(MEMBER)
  status      CommunityMembershipStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      StudentProfile @relation("CommunityMembershipUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@index([userId, status])
}

model Post {
  id          String    @id @default(uuid())
  authorId    String
  communityId String
  content     String
  /// What kind of academic content this post is. Every post carries one; a post
  /// written before types existed is a DISCUSSION, which is also the default for
  /// a client that does not choose a type.
  type        PostType  @default(DISCUSSION)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  author    StudentProfile @relation("PostAuthor", fields: [authorId], references: [userId], onDelete: Cascade)
  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions PostReaction[]

  @@index([authorId])
  @@index([communityId, createdAt])
  @@index([communityId, deletedAt])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author    StudentProfile   @relation("CommentAuthor", fields: [authorId], references: [userId], onDelete: Cascade)
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([authorId])
  @@index([postId, createdAt])
  @@index([postId, deletedAt])
}

/// Reactions are modelled per target so PostgreSQL can enforce real foreign
/// keys and uniqueness instead of relying on a polymorphic target column.
/// The unique index already covers lookups by postId, so no extra index is
/// needed for it.
model PostReaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  post Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user StudentProfile @relation("PostReactionUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([userId])
}

/// See PostReaction: the unique index already covers lookups by commentId.
model CommentReaction {
  id        String       @id @default(uuid())
  commentId String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  comment Comment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    StudentProfile @relation("CommentReactionUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([commentId, userId, type])
  @@index([userId])
}

/// Authorisation roles only: whether an account may administer the platform.
/// Mentor and educator standing is profile data, not an account role.
enum UserRole {
  USER
  ADMIN
}

/// Account lifecycle. DELETED is a soft delete: sessions are revoked, but the
/// content the account authored stays readable so community history holds
/// together.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum CommunityType {
  PUBLIC
  PRIVATE
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

/// The kinds of academic content a post can carry. The set is closed and small
/// on purpose: a student should be able to tell what a post is at a glance, and
/// an open vocabulary would make that impossible. DISCUSSION is the default, so
/// content written before this enum existed stays valid.
enum PostType {
  DISCUSSION
  QUESTION
  RESOURCE
  ACHIEVEMENT
  RESEARCH
  ANNOUNCEMENT
  OPPORTUNITY
}

enum ReactionType {
  LIKE
}
