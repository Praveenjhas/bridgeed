# Copy this file to `apps/mobile/.env` and adjust it for your machine.
#
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle by
# Metro, which also means they are readable by anyone who inspects the bundle.
# Never put secrets in this file.

# API root of the local BridgeEd backend, without the /api/v1 suffix.
#
# Leave it empty to let the app derive the host from the Expo dev server, which
# is what you want when you run the backend on the same machine as the dev
# server. Set it explicitly whenever that guess is wrong, most importantly on a
# physical phone: a phone cannot reach "localhost", so use the LAN address of
# the computer running the API, for example:
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.24:4000
#
EXPO_PUBLIC_API_URL=
